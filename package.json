{
  "name": "expressionlab",
  "version": "0.0.2-alpha",
  "description": "Expression Lab is a sandboxed diagnostics and data inspection environment for WordPress.",
  "main": "index.js",
  "scripts": {
    "dev-server": "encore dev-server",
    "dev": "encore dev",
    "watch": "encore dev --watch",
    "build": "encore production --progress",
    "build:zip": "bash bin/build-plugin.sh",
    "lint": "pnpm lint:js && pnpm lint:php && pnpm lint:css",
    "lint:js": "eslint",
    "lint:js:fix": "eslint --fix",
    "lint:php": "vendor/bin/phpcs",
    "lint:php:fix": "vendor/bin/phpcbf",
    "lint:css": "stylelint 'assets/scss/**/*.{css,scss}' 'assets/js/**/*.vue'",
    "lint:css:fix": "stylelint 'assets/scss/**/*.{css,scss}' 'assets/js/**/*.vue' --fix",
    "test": "pnpm test:js && pnpm test:php",
    "test:js": "jest",
    "test:php": "vendor/bin/phpunit --exclude-group multisite",
    "test:php:ms": "WP_MULTISITE=1 vendor/bin/phpunit --exclude-group singlesite",
    "test:php:all": "vendor/bin/phpunit --exclude-group multisite && WP_MULTISITE=1 vendor/bin/phpunit --exclude-group singlesite",
    "i18n:make-pot": "wp i18n make-pot . languages/expression-lab.pot --slug=expression-lab --domain=expression-lab --exclude=\"docs,assets/build,assets/fonts,assets/img,tests\"",
    "docs:install": "pnpm --dir docs install",
    "docs:dev": "pnpm --dir docs start",
    "docs:dev:es": "pnpm --dir docs start --locale es",
    "docs:build": "pnpm --dir docs build",
    "docs:serve": "pnpm --dir docs serve",
    "docs:version": "pnpm --dir docs docusaurus docs:version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andersonsalas/expressionlab.git"
  },
  "keywords": [
    "WordPress",
    "editor",
    "plugin"
  ],
  "author": "Anderson Salas <github@andersonsalas.com>",
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/andersonsalas/expressionlab/issues"
  },
  "homepage": "https://github.com/andersonsalas/expressionlab#readme",
  "devDependencies": {
    "@babel/core": "^7.27.7",
    "@babel/node": "^7.27.1",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.27.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.31.0",
    "@pinia/testing": "^1.0.3",
    "@symfony/webpack-encore": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "bootstrap": "^5.3.7",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.3.0",
    "globals": "^16.3.0",
    "jest": "^26.6.3",
    "jest-environment-jsdom": "^26.6.2",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "stylelint": "^16.22.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-config-standard-vue": "^1.0.0",
    "vue": "^3.5.17",
    "vue-jest": "^5.0.0-alpha.10",
    "vue-loader": "^17.4.2",
    "vue-template-compiler": "^2.7.16",
    "webpack-dev-server": "^5.2.2",
    "wrangler": "^4.130.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/basic-setup": "^0.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/highlight": "^0.19.8",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.8",
    "@fsegurai/codemirror-theme-bundle": "^6.3.0",
    "@fsegurai/codemirror-theme-github-light": "^6.2.3",
    "@iconoir/vue": "^7.11.0",
    "@noble/curves": "^2.0.1",
    "@vscode/codicons": "^0.0.44",
    "codemirror": "^6.0.2",
    "core-js": "^3.49.0",
    "d3": "^7.9.0",
    "dompurify": "^3.3.0",
    "dotenv": "^17.0.0",
    "hash-wasm": "^4.12.0",
    "highlight.js": "^11.9.0",
    "marked": "^17.0.4",
    "pinia": "^3.0.3",
    "thememirror": "^2.0.1",
    "unicode-emoji-json": "^0.8.0",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-interpreter": "^2.2.1",
    "vega-lite": "^6.4.2",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.0.7",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  }
}
