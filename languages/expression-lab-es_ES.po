#: src/admin/pages/class-onboarding.php:97
msgid "Passphrase:"
msgstr "Contraseña:"

#: src/admin/pages/class-onboarding.php:98
msgid "Min 8 characters"
msgstr "Mínimo 8 caracteres"

#: src/admin/pages/class-onboarding.php:99
msgid "This passphrase is used only to derive the private key. Keep the following in mind:"
msgstr "Esta contraseña se utiliza para derivar la clave privada. Aspectos a considerar:"

#: src/admin/pages/class-onboarding.php:100
msgid "<strong>Zero storage:</strong> Neither this passphrase nor the derived private key are ever stored on the server or the database."
msgstr "<strong>Sin almacenamiento:</strong> Ni esta contraseña ni la clave privada derivada se almacenan jamás en el servidor ni en la base de datos."

#: src/admin/pages/class-onboarding.php:101
msgid "<strong>Security:</strong> Avoid reusing WordPress passwords or trivial terms (e.g., <code>admin</code>, <code>12345678</code>)."
msgstr "<strong>Seguridad:</strong> Se desaconseja reutilizar contraseñas de WordPress o términos triviales (por ejemplo, <code>admin</code>, <code>12345678</code>)."

#: src/admin/pages/class-onboarding.php:102
msgid "<strong>No recovery:</strong> If this passphrase is lost, cryptographic constants must be removed from <code>wp-config.php</code> to restart the setup."
msgstr "<strong>Sin recuperación:</strong> En caso de pérdida de esta contraseña, se deben eliminar las constantes criptográficas del archivo <code>wp-config.php</code> para reiniciar la configuración."

#: src/admin/pages/class-onboarding.php:103
