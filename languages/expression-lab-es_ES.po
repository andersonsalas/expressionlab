#: src/admin/pages/class-onboarding.php:144
msgid "Engine constraints"
msgstr "Restricciones del motor"

#: src/admin/pages/class-onboarding.php:145
msgid "Max execution time"
msgstr "Tiempo máximo de ejecución"

#: src/admin/pages/class-onboarding.php:146
msgid "Maximum execution time in seconds allocated per expression prior to process termination. Default: 2 seconds."
msgstr "Tiempo máximo de ejecución en segundos asignado por expresión antes de finalizar el proceso. Por defecto: 2 segundos."

#: src/admin/pages/class-onboarding.php:147
msgid "seconds"
msgstr "segundos"

#: src/admin/pages/class-onboarding.php:148
msgid "Enter a whole number of seconds greater than zero."
msgstr "Introduce un número entero de segundos mayor que cero."

#: src/admin/pages/class-onboarding.php:149
msgid "Signature duration"
msgstr "Duración de la firma"

#: src/admin/pages/class-onboarding.php:150
msgid "How long signed requests remain valid before expiring. The default 120 seconds works well for most setups."
msgstr "Cuánto tiempo permanecen válidas las solicitudes firmadas antes de expirar. El valor predeterminado de 120 segundos funciona bien en la mayoría de los entornos."

#: src/admin/pages/class-onboarding.php:151
msgid "Integrations"
msgstr "Integraciones"

#: src/admin/pages/class-onboarding.php:152
msgid "MaxMind license key"
msgstr "Clave de licencia de MaxMind"

#: src/admin/pages/class-onboarding.php:153
msgid "Optional key used to download and update the local GeoLite2 database."
msgstr "Clave opcional utilizada para descargar y actualizar la base de datos local GeoLite2."

#: src/admin/pages/class-onboarding.php:154
msgid "Invalid license key. MaxMind license keys contain only letters, digits, hyphens and underscores."
msgstr "Clave de licencia no válida. Las claves de MaxMind solo contienen letras, dígitos, guiones y guiones bajos."

#: src/admin/pages/class-onboarding.php:155
msgid "Once the setup is completed, run <code>wp expressionlab iplookup update</code> to fetch the file."
msgstr "Una vez completada la configuración, ejecuta <code>wp expressionlab iplookup update</code> para descargar el archivo."

#: src/admin/pages/class-onboarding.php:156
msgid "Keys already generated"
msgstr "Claves ya generadas"

#: src/admin/pages/class-onboarding.php:157
msgid "Leave the passphrase empty and continue to keep the keys generated in this session, or enter a new passphrase to generate a new key pair."
msgstr "Deja la contraseña vacía y continúa para conservar las claves generadas en esta sesión, o introduce una nueva contraseña para generar un nuevo par de claves."

#: src/admin/pages/class-onboarding.php:160
msgid "This passphrase derives the Ed25519 signing key in your browser."
msgstr "Esta contraseña deriva la clave de firma Ed25519 en tu navegador."

#: src/admin/pages/class-onboarding.php:161
msgid "<strong>Zero storage:</strong> Neither the passphrase nor the private key touches the database or server filesystem."
msgstr "<strong>Almacenamiento cero:</strong> Ni la contraseña ni la clave privada tocan la base de datos o el sistema de archivos del servidor."

#: src/admin/pages/class-onboarding.php:162
msgid "<strong>Separation of access:</strong> Use a distinct phrase rather than your WordPress user password."
msgstr "<strong>Separación de acceso:</strong> Usa una frase distinta a tu contraseña de usuario de WordPress."

#: src/admin/pages/class-onboarding.php:163
msgid "<strong>No recovery:</strong> If forgotten, reset requires removing the authentication constants from <code>wp-config.php</code>"
msgstr "<strong>Sin recuperación:</strong> Si la olvidas, restablecerla requiere eliminar las constantes de autenticación de <code>wp-config.php</code>"

#: src/admin/pages/class-onboarding.php:164
msgid "Continue"
msgstr "Continuar"

#: src/admin/pages/class-onboarding.php:167
msgid "Activation requires filesystem-level persistence. Paste the following constants into your <code>wp-config.php</code> file:"
msgstr "La activación requiere persistencia a nivel de sistema de archivos. Pega las siguientes constantes en tu archivo <code>wp-config.php</code>:"

#: src/admin/pages/class-onboarding.php:168
msgid "Once the file is saved, reload this page to validate the configuration and unlock the console."
msgstr "Una vez guardado el archivo, recarga esta página para validar la configuración y desbloquear la consola."

#: src/admin/pages/class-onboarding.php:170
msgid "Expression Lab Professional Edition by Anderson Salas. Built on the open-source Expression Lab core."
msgstr "Expression Lab Professional Edition por Anderson Salas. Basado en el núcleo de código abierto de Expression Lab."

#: src/admin/pages/class-onboarding.php:171
msgid "I have read and accept the"
msgstr "He leído y acepto el"

#: src/admin/pages/class-onboarding.php:172
msgid "End-User License Agreement (EULA)"
msgstr "Acuerdo de Licencia de Usuario Final (EULA)"

#: src/core/class-loader.php:117
msgid "Staging mismatch:"
msgstr "Discordancia de entorno de staging:"

#. translators: 1: current site URL or domain, 2: configured staging URL pattern
#: src/core/class-loader.php:121
#, php-format
msgid "Current environment (%1$s) does not match the configured staging URL (%2$s). Expression Lab console is disabled."
msgstr "El entorno actual (%1$s) no coincide con la URL de staging configurada (%2$s). La consola de Expression Lab está desactivada."

#. translators: %s: name of the wp-config.php constant
#: src/core/class-loader.php:128
#, php-format
msgid "If this site is a legitimate staging environment, update or remove the %s constant in wp-config.php to re-enable it."
msgstr "Si este sitio es un entorno de staging legítimo, actualiza o elimina la constante %s en wp-config.php para volver a habilitarla."

#: src/admin/pages/class-onboarding.php:102
msgid "Operational Notice: Live Environment Diagnostics"
msgstr "Aviso operativo: diagnóstico en entornos en vivo"

#: src/admin/pages/class-onboarding.php:103
msgid "Expression Lab executes low-level diagnostics, AST expressions, and direct data inspections. While designed with execution boundaries and sandboxing, running complex queries on high-traffic production environments carries operational risks and is done at your own discretion without warranty."
msgstr "Expression Lab ejecuta diagnósticos de bajo nivel, expresiones AST e inspecciones directas de datos. Aunque está diseñado con límites de ejecución y aislamiento (sandbox), ejecutar consultas complejas en entornos de producción con alto tráfico conlleva riesgos operativos y se realiza bajo tu propio criterio y sin garantía."

#: src/admin/pages/class-onboarding.php:104
msgid "I acknowledge that Expression Lab performs low-level diagnostics and accept full responsibility for running executions on production environments."
msgstr "Reconozco que Expression Lab realiza diagnósticos de bajo nivel y asumo toda la responsabilidad al ejecutar consultas en entornos de producción."
